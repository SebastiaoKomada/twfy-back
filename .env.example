# Todas as variáveis têm default sensato para desenvolvimento local;
# copie para .env e ajuste apenas o que precisar em produção.

ENVIRONMENT=development
SESSION_TTL_DAYS=7

# No container, o Compose define /app/data/tw4y.db em um volume persistente.
# DATABASE_PATH=/caminho/para/tw4y.db

# Limite global de requisições por IP (rede de segurança contra abuso/custo
# na AWS). Ex.: "120/minute". Ver teacher/GABARITO.md para o motivo de não
# usar isso como controle de força bruta por conta.
GLOBAL_RATE_LIMIT=120/minute
